NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ocms

# Swagger Configuration
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_REFRESH_EXPIRATION=7d

# Throttling / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# Stripe Configuration (Test Mode)
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_testing
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret_for_testing
STRIPE_SUCCESS_URL=http://localhost:3000/student/enrollments?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/courses/{COURSE_ID}?payment=cancelled
STRIPE_CURRENCY=usd
